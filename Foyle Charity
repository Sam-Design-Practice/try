<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Foyle Food Bank & Network | Community Support & Monthly Giving</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f4f5f7;
      --white: #ffffff;
      --dark: #0f172a;
      --green: #1f7a5a;
      --green-soft: rgba(31, 122, 90, 0.12);
      --amber: #f9b94a;
      --muted: #5f6c7b;
      --radius: 1.25rem;
      --shadow: 0 18px 40px rgba(15, 23, 42, 0.05);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #ffffff 0%, #f4f5f7 50%, #edf0f4 100%);
      color: #0f172a;
      line-height: 1.6;
    }
    .container { width: min(1100px, 92%); margin: 0 auto; }
    header.navbar {
      position: sticky; top: 0; z-index: 50;
      background: rgba(244,245,247,0.8);
      backdrop-filter: blur(6px);
      border-bottom: 1px solid rgba(15,23,42,0.03);
    }
    .nav-inner {
      height: 66px; display: flex; align-items: center; justify-content: space-between; gap: 1.2rem;
    }
    .brand { display: flex; align-items: center; gap: .55rem; cursor: pointer; }
    .logo-pill {
      background: var(--green);
      color: #fff;
      padding: .3rem .7rem;
      border-radius: .6rem;
      font-weight: 700;
      font-size: .8rem;
    }
    .brand span:last-child { font-weight: 700; letter-spacing: .02rem; }
    nav a { text-decoration: none; color: #0f172a; font-weight: 500; font-size: .9rem; }
    .nav-links { display: flex; gap: 1.1rem; }
    .btn {
      display: inline-block;
      background: var(--green);
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: .5rem 1.1rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: transform .1s ease-out;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-outline {
      background: rgba(31,122,90,0.12);
      color: var(--green);
    }
    .mobile-toggle { display: none; font-size: 1.4rem; cursor: pointer; }

    /* HERO */
    .hero {
      padding: 4.5rem 0 3.2rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr .9fr;
      gap: 2.5rem;
      align-items: center;
    }
    .eyebrow {
      display: inline-block;
      background: rgba(31,122,90,0.08);
      color: var(--green);
      padding: .25rem .7rem;
      border-radius: 999px;
      font-size: .7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .04rem;
      margin-bottom: 1.1rem;
    }
    h1 {
      font-size: clamp(2.4rem, 4vw, 3.1rem);
      line-height: 1.05;
      margin-bottom: 1rem;
    }
    .hero-sub {
      color: var(--muted);
      max-width: 540px;
      margin-bottom: 1.4rem;
    }
    .dual-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.4rem;
    }
    .dual-btn {
      display: flex;
      flex-direction: column;
      background: #fff;
      border-radius: 1rem;
      padding: .7rem 1rem;
      box-shadow: var(--shadow);
      border: 1px solid rgba(15,23,42,0.03);
      width: 210px;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
    }
    .dual-btn small { color: var(--muted); font-size: .7rem; }
    .hero-card {
      background: #fff;
      border-radius: 1.1rem;
      padding: 1.4rem 1.6rem 1.1rem;
      box-shadow: var(--shadow);
    }
    .hero-card h2 { font-size: 1rem; margin-bottom: .5rem; }
    .stat-row {
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(31,122,90,0.07);
      border-radius: .8rem;
      padding: .4rem .7rem;
      margin: .7rem 0;
    }
    .stat-value { font-size: 1.5rem; font-weight: 700; }
    .hero-foot {
      background: rgba(249, 185, 74, 0.12);
      border-radius: .7rem;
      padding: .5rem .6rem;
      font-size: .75rem;
      margin-top: .6rem;
    }

    /* SECTION */
    .section { padding: 3.3rem 0; }
    .section-heading { margin-bottom: 2rem; }
    .section-heading h2 { font-size: 1.5rem; margin-bottom: .3rem; }
    .section-heading p { color: var(--muted); }
    .section-alt { background: #fff; border-top: 1px solid rgba(15,23,42,0.03); }

    /* SUPPORT CHOICES */
    .support-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.3rem;
    }
    .support-card {
      background: #fff;
      border-radius: 1rem;
      padding: 1.1rem 1.1rem 1rem;
      box-shadow: var(--shadow);
      border: 1px solid rgba(15,23,42,0.02);
    }
    .support-card h3 { margin-bottom: .4rem; }
    .support-card p { color: var(--muted); font-size: .85rem; margin-bottom: .7rem; }
    .support-card ul { padding-left: 1.1rem; margin-bottom: .7rem; }
    .support-card li { font-size: .78rem; margin-bottom: .35rem; }

    /* DONATION */
    .donation-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin-bottom: 1.4rem;
    }
    .donation-card {
      background: rgba(31,122,90,0.04);
      border-radius: 1rem;
      padding: 1rem;
      cursor: pointer;
      border: 2px solid transparent;
      transition: .1s;
    }
    .donation-card h3 { margin-bottom: .3rem; }
    .donation-card.active {
      border-color: var(--green);
      background: #fff;
      box-shadow: var(--shadow);
    }
    .donation-form {
      background: rgba(244,245,247,0.7);
      border-radius: 1rem;
      padding: 1.1rem;
      max-width: 420px;
    }
    .donation-form label {
      display: block;
      margin-bottom: .3rem;
      font-weight: 500;
      font-size: .85rem;
    }
    .donation-form input {
      width: 100%;
      padding: .55rem .6rem;
      border-radius: .55rem;
      border: 1px solid rgba(15,23,42,0.07);
      margin-bottom: .6rem;
      font-size: .9rem;
    }
    .small-hint { font-size: .7rem; color: var(--muted); }

    /* IMPACT DASHBOARD */
    .impact-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 1rem;
    }
    .impact-card {
      background: #fff;
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: var(--shadow);
    }
    .impact-title { font-size: .8rem; color: var(--muted); }
    .impact-number { font-size: 1.8rem; font-weight: 700; margin: .4rem 0; }
    .impact-foot { font-size: .68rem; color: var(--muted); }

    /* STORIES */
    .stories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.1rem;
    }
    .story-card {
      background: #fff;
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: var(--shadow);
      border-left: 4px solid rgba(31,122,90,0.5);
    }
    .story-meta { font-size: .7rem; color: var(--muted); margin-bottom: .2rem; }
    .story-card h3 { font-size: .95rem; margin-bottom: .4rem; }

    /* PARTNERS / CTA */
    .partners {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .partner-pill {
      background: #fff;
      border-radius: 999px;
      padding: .4rem .9rem;
      box-shadow: var(--shadow);
      font-size: .75rem;
      font-weight: 500;
    }

    /* FOOTER */
    footer {
      background: #0f172a;
      color: #fff;
      padding: 2.5rem 0 1.4rem;
      margin-top: 3rem;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.4rem;
    }
    footer h4 { margin-bottom: .5rem; }
    footer a { color: #fff; text-decoration: none; font-size: .8rem; }
    .footer-bottom { text-align: center; margin-top: 1.4rem; font-size: .7rem; color: rgba(255,255,255,.6); }

    /* RESPONSIVE */
    @media (max-width: 880px) {
      .hero-grid { grid-template-columns: 1fr; }
      .nav-links { display: none; }
      .mobile-toggle { display: block; }
    }
  </style>
</head>
<body>
  <!-- NAV -->
  <header class="navbar">
    <div class="container nav-inner">
      <div class="brand" onclick="window.scrollTo({top:0,behavior:'smooth'})">
        <span class="logo-pill">Foyle</span>
        <span>Food Bank & Network</span>
      </div>
      <nav class="nav-links">
        <a href="#support">Get support</a>
        <a href="#donate">Give monthly</a>
        <a href="#impact">Impact</a>
        <a href="#stories">Stories</a>
      </nav>
      <a href="#donate" class="btn btn-sm">Donate</a>
      <div class="mobile-toggle" id="mobileToggle">☰</div>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">No judgement. Local support. Real impact.</span>
        <h1>Nobody in Derry-Londonderry should face hunger alone.</h1>
        <p class="hero-sub">
          Foyle Food Bank and Foyle Network provide emergency food, guidance and community links. We rely on local people and businesses to keep that support going.
        </p>
        <div class="dual-actions">
          <a href="#support" class="dual-btn">
            <strong>I need support</strong>
            <small>How to get a food parcel, referrals & advice</small>
          </a>
          <a href="#donate" class="dual-btn">
            <strong>I want to help</strong>
            <small>Set up a monthly gift or partner with us</small>
          </a>
        </div>
        <p style="font-size:.75rem; color:var(--muted);">We work with local agencies, health professionals and community groups.</p>
      </div>
      <div class="hero-card">
        <h2>Last month at a glance</h2>
        <div class="stat-row">
          <div>
            <p style="font-size:.7rem; color:var(--muted);">People supported</p>
            <p class="stat-value" id="peopleStat">874</p>
          </div>
          <span style="font-size:.65rem; background:#fff; padding:.2rem .5rem; border-radius:.5rem;">+12% vs previous month</span>
        </div>
        <div class="stat-row">
          <div>
            <p style="font-size:.7rem; color:var(--muted);">Parcels issued</p>
            <p style="font-weight:600;">421</p>
          </div>
          <p style="font-size:.7rem; color:var(--muted);">Families & individuals</p>
        </div>
        <div class="stat-row">
          <div>
            <p style="font-size:.7rem; color:var(--muted);">Active monthly donors</p>
            <p style="font-weight:600;" id="donorCount">163</p>
          </div>
          <p style="font-size:.7rem; color:var(--muted);">Target: 250</p>
        </div>
        <div class="hero-foot">
          Your monthly support helps us say “yes” when people reach out.
        </div>
      </div>
    </div>
  </section>

  <!-- SUPPORT SECTION -->
  <section class="section" id="support">
    <div class="container">
      <div class="section-heading">
        <h2>If you need help, you’re welcome here.</h2>
        <p>Food support is for anyone in crisis — job loss, low income, sudden bills or personal difficulties.</p>
      </div>
      <div class="support-grid">
        <div class="support-card">
          <h3>How to get food</h3>
          <p>We work through a referral system to make sure you get the right support.</p>
          <ul>
            <li>Speak to your GP, social worker or local advice centre</li>
            <li>Get a referral / voucher</li>
            <li>Collect your parcel from our centre</li>
          </ul>
          <a href="#contact" class="btn btn-outline">Find referral partners</a>
        </div>
        <div class="support-card">
          <h3>What you’ll receive</h3>
          <p>Three days’ worth of nutritionally balanced food and essentials.</p>
          <ul>
            <li>Dry & tinned goods</li>
            <li>Household & hygiene items</li>
            <li>Friendly volunteers on site</li>
          </ul>
        </div>
        <div class="support-card">
          <h3>Extra support</h3>
          <p>We can point you towards services for debt, benefits, housing or wellbeing.</p>
          <ul>
            <li>Signposting to local services</li>
            <li>Links to Foyle Network partners</li>
            <li>Support for families</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DONATE SECTION -->
  <section class="section section-alt" id="donate">
    <div class="container">
      <div class="section-heading">
        <h2>Give monthly to keep shelves full</h2>
        <p>Regular donations help us plan, buy what’s missing, and respond quickly to families.</p>
      </div>
      <div class="donation-grid">
        <div class="donation-card active" data-amount="10">
          <h3>£10 / month</h3>
          <p>Covers core items for a family for 3 days.</p>
        </div>
        <div class="donation-card" data-amount="20">
          <h3>£20 / month</h3>
          <p>Helps top up parcels during high demand.</p>
        </div>
        <div class="donation-card" data-amount="35">
          <h3>£35 / month</h3>
          <p>Supports households plus hygiene items.</p>
        </div>
        <div class="donation-card" data-amount="custom">
          <h3>Choose amount</h3>
          <p>Every pound helps.</p>
        </div>
      </div>
      <form class="donation-form" onsubmit="return false;">
        <label for="donationAmount">Monthly amount (£)</label>
        <input type="number" id="donationAmount" min="1" value="10" />
        <button type="button" class="btn" id="donateBtn">Continue to donate</button>
        <p class="small-hint">You’ll be taken to our secure donation page to complete your monthly gift.</p>
      </form>
    </div>
  </section>

  <!-- IMPACT DASHBOARD -->
  <section class="section" id="impact">
    <div class="container">
      <div class="section-heading">
        <h2>Impact we can show donors</h2>
        <p>We share updates so you can see what your money is doing in Derry-Londonderry.</p>
      </div>
      <div class="impact-cards">
        <div class="impact-card">
          <p class="impact-title">Parcels given this month</p>
          <p class="impact-number" id="parcelsCount">421</p>
          <p class="impact-foot">Updated monthly</p>
        </div>
        <div class="impact-card">
          <p class="impact-title">People supported</p>
          <p class="impact-number" id="peopleCount">874</p>
          <p class="impact-foot">Families, children, individuals</p>
        </div>
        <div class="impact-card">
          <p class="impact-title">Active monthly donors</p>
          <p class="impact-number" id="donorDisplay">163</p>
          <p class="impact-foot">Goal: 250</p>
        </div>
        <div class="impact-card">
          <p class="impact-title">Business partners</p>
          <p class="impact-number">14</p>
          <p class="impact-foot">CSR & community supporters</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STORIES -->
  <section class="section section-alt" id="stories">
    <div class="container">
      <div class="section-heading">
        <h2>Stories from people & businesses</h2>
        <p>These are the voices that show why your support matters.</p>
      </div>
      <div class="stories-grid">
        <article class="story-card">
          <p class="story-meta">Parent, Derry</p>
          <h3>“I was nervous coming, but the volunteers were kind.”</h3>
          <p>Being welcomed with dignity made it easier to ask for help. The food lasted until payday.</p>
        </article>
        <article class="story-card">
          <p class="story-meta">Volunteer</p>
          <h3>“Monthly donations mean we don’t have to turn people away.”</h3>
          <p>When stock is steady, we can say yes more often. That’s the difference regular giving makes.</p>
        </article>
        <article class="story-card">
          <p class="story-meta">Local café partner</p>
          <h3>“We give every month because it’s local.”</h3>
          <p>Our staff like knowing their contribution feeds people in their own city.</p>
        </article>
      </div>
      <div style="margin-top:1.5rem;">
        <p class="small-hint">Want your organisation to be featured? Get in touch and we’ll share your story too.</p>
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="section" id="partners">
    <div class="container">
      <div class="section-heading">
        <h2>Support for people, families and businesses</h2>
        <p>We work with the wider Foyle Network to point people to the right help.</p>
      </div>
      <div class="partners">
        <span class="partner-pill">Advice & benefits guidance</span>
        <span class="partner-pill">Housing & wellbeing signposting</span>
        <span class="partner-pill">Family & youth support links</span>
        <span class="partner-pill">CSR partnership for businesses</span>
        <span class="partner-pill">Food collection points</span>
      </div>
      <div style="margin-top:1.3rem;">
        <a href="#donate" class="btn">Become a monthly supporter</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer id="contact">
    <div class="container footer-grid">
      <div>
        <h4>Foyle Food Bank & Network</h4>
        <p>Working so no one goes hungry in Derry-Londonderry.</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p>info@foylefoodbank.org.uk</p>
        <p>Tel: 0000 000 000</p>
      </div>
      <div>
        <h4>Visit / Get help</h4>
        <a href="#support">How to get support</a><br>
        <a href="#donate">Donate monthly</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Registered charity. Community powered.</p>
    </div>
  </footer>

  <script>
    // donation card interactions
    const donationCards = document.querySelectorAll(".donation-card");
    const donationInput = document.getElementById("donationAmount");
    const donateBtn = document.getElementById("donateBtn");
    const mobileToggle = document.getElementById("mobileToggle");
    const navLinks = document.querySelector(".nav-links");

    donationCards.forEach(card => {
      card.addEventListener("click", () => {
        donationCards.forEach(c => c.classList.remove("active"));
        card.classList.add("active");
        const amount = card.getAttribute("data-amount");
        if (amount === "custom") {
          donationInput.focus();
          donationInput.value = "";
        } else {
          donationInput.value = amount;
        }
      });
    });

    donateBtn.addEventListener("click", () => {
      const amount = donationInput.value || "10";
      alert("Thank you for choosing to give £" + amount + " monthly. You would now be taken to our secure donation page to complete this.");
    });

    mobileToggle.addEventListener("click", () => {
      if (navLinks.style.display === "flex") {
        navLinks.style.display = "none";
      } else {
        navLinks.style.display = "flex";
        navLinks.style.flexDirection = "column";
        navLinks.style.position = "absolute";
        navLinks.style.top = "66px";
        navLinks.style.right = "1rem";
        navLinks.style.background = "#fff";
        navLinks.style.padding = "1rem";
        navLinks.style.borderRadius = "1rem";
        navLinks.style.gap = ".7rem";
        navLinks.style.boxShadow = "0 10px 30px rgba(15,23,42,.12)";
      }
    });
  </script>
</body>
</html>
